# This example shows the "secrets" that should be set via environment variables.
# Use this as a template to create a .env file in your project directory, and edit
# that file to change the values.

# Security Configuration
# Session password for JWT tokens (32+ characters, generate with: openssl rand -base64 32)
NUXT_SESSION_PASSWORD="password-with-at-least-32-characters"

# Email Configuration (SMTP)
# SMTP server settings for sending emails
NUXT_EMAIL_HOST="smtp.gmail.com"
NUXT_EMAIL_PORT="587"
NUXT_EMAIL_SECURE="false"
NUXT_EMAIL_USER="your-email@gmail.com"
NUXT_EMAIL_PASS="your-app-password"
NUXT_EMAIL_FROM="noreply@yourdomain.com"

# LTI 1.3 Configuration
# The private key for the tool (PKCS8 format)
NUXT_LTI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
NUXT_LTI_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# The Key ID for the tool's public key
NUXT_LTI_KEY_ID="lti-key-1"

# Canvas API Token
# Used by the seed script to populate LTI identities with an API key for assignment sync.
# Generate one in Canvas: Account → Settings → New Access Token.
# Replace this placeholder after seeding, or set it before running `pnpm prisma db seed`.
CANVAS_API_TOKEN="replace-with-your-canvas-api-token"
