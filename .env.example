# This example shows the "secrets" that should be set via environment variables.
# Use this as a template to create a .env file in your project directory, and edit
# that file to change the values.

# Security Configuration
# Session password for JWT tokens (32+ characters, generate with: openssl rand -base64 32)
NUXT_SESSION_PASSWORD="password-with-at-least-32-characters"

# Email Configuration (SMTP)
# SMTP server settings for sending emails
NUXT_EMAIL_HOST="smtp.gmail.com"
NUXT_EMAIL_PORT="587"
NUXT_EMAIL_SECURE="false"
NUXT_EMAIL_USER="your-email@gmail.com"
NUXT_EMAIL_PASS="your-app-password"
NUXT_EMAIL_FROM="noreply@yourdomain.com"
