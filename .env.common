# This file contains non-secret common environment variable settings 
# shared by all developers. Secrets should be kept in .env.

# Application Configuration
# This version MUST match the version defined in package.json
APP_VERSION="0.0.1"

# Database Configuration
POSTGRES_DB="egpbroker"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="P@ssw0rd"
POSTGRES_PORT=5432

# Main database connection (required)
NUXT_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}"
# Test database connection (required for testing)
TEST_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}_test"

# Site URL for SEO and canonical links
NUXT_SITE_URL="http://localhost:3000"
NUXT_SITE_NAME="EGP Broker"

# Rate Limiting Configuration
# Login attempts rate limiting (failed attempts per email+IP)
NUXT_RATE_LIMIT_LOGIN_MAX=5
NUXT_RATE_LIMIT_LOGIN_WINDOW=15
# Token request cooldown (minutes between verification emails)
NUXT_RATE_LIMIT_TOKEN_COOLDOWN=5

# Development Configuration
NODE_ENV="development"
# Suppress warnings about old browser mapping data (common in Nuxt SEO)
BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA="true"
BROWSERSLIST_IGNORE_OLD_DATA="true"
# DEBUG="nuxt:*"
# PORT="3000"
# Playwright Configuration
PW_TEST_CONNECT_WS_ENDPOINT="ws://playwright:3001/"
