// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("NUXT_DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum GlobalRole {
  ADMIN
  INSTRUCTOR
  USER
  PROCTOR
}

enum CourseRole {
  TEACHER
  STUDENT
  TA
  OBSERVER
  DESIGNER
  ADMIN
}

/// A user of the system (Student, Teacher, or Admin).
model User {
  id              String     @id @default(cuid())
  email           String     @unique
  studentId       String?    @unique
  password        String?
  firstName       String
  lastName        String
  globalRole      GlobalRole @default(USER)
  emailVerified   Boolean    @default(false)
  emailVerifiedAt DateTime?
  avatarUrl       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  tokens           Token[]
  ltiIdentities    LtiIdentity[]
  casIdentities    CasIdentity[]
  enrollments      Enrollment[]
  passPools        StudentPassPool[]
  ltiResults       LtiResult[]
  overrideStudents AssignmentOverrideStudent[]
  cbtfReservations CbtfReservation[]
  proctorShifts    CbtfProctorShift[]
  cbtfNotesAuthored CbtfReservationNote[]

  // Current context
  currentCourseId String?
  currentCourse   Course? @relation("UserCurrentCourse", fields: [currentCourseId], references: [id], onDelete: SetNull)

  // Essential index only
  @@index([emailVerified])
  @@index([studentId])
}

/// An LTI 1.3 Platform (e.g., Canvas instance).
model LtiPlatform {
  id            String   @id @default(cuid())
  issuer        String   @unique // iss claim (e.g., https://canvas.instructure.com)
  clientId      String // aud claim
  authEndpoint  String // OIDC auth initiation endpoint
  tokenEndpoint String // OIDC token endpoint
  jwksEndpoint  String // Platform's public keys
  name          String? // Friendly name
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deployments LtiDeployment[]
  identities  LtiIdentity[]
  tools       LtiTool[]
  ltiResults  LtiResult[] 
}

enum Protocol {
  LTI11
  LTI13
  SPLICE
}

/// An external LTI tool configuration (e.g. Gradescope, Piazza).
model LtiTool {
  id                 String      @id @default(cuid())
  platformId         String?
  platform           LtiPlatform? @relation(fields: [platformId], references: [id], onDelete: SetNull)

  //assignments related with this tool
  assignments        Assignment[]

  name               String?
  baseUrl            String
  protocol           Protocol
  key                String?
  secret             String?
  supportsExtensionApi Boolean   @default(false)

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([platformId])
}

/// A specific installation/deployment of the tool within an LTI Platform.
model LtiDeployment {
  id             String  @id @default(cuid())
  platformId     String
  deploymentId   String // LTI deployment_id claim
  deploymentHost String? // Optional guid/host from tool_platform claim

  platform   LtiPlatform   @relation(fields: [platformId], references: [id], onDelete: Cascade)
  identities LtiIdentity[]
  courses    Course[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([platformId, deploymentId])
}

/// Linkage between a local User and an LTI Platform Identity.
model LtiIdentity {
  id             String  @id @default(cuid())
  userId         String
  platformId     String
  ltiSub         String // sub claim (unique user id in the platform)
  platformUserId String? // Optional platform-specific numeric ID (e.g. from Canvas legacy_user_id claim)
  /// ⚠️ SECURITY RISK: Stored as plain text. If the database is compromised, all
  /// user API keys are exposed. Future work: encrypt at the application layer
  /// using an AES key stored in a secrets manager (e.g. NUXT_PLATFORM_API_KEY_SECRET).
  platformApiKey String? // Optional API key for this user on the platform

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     LtiPlatform    @relation(fields: [platformId], references: [id], onDelete: Cascade)
  deployment   LtiDeployment? @relation(fields: [platformId, deploymentId], references: [platformId, deploymentId])
  deploymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformId, ltiSub])
  @@unique([userId, platformId])
}

/// Stores LTI outcome launch details and grade synchronization state.
model LtiResult {
  id                      String   @id @default(cuid())
  user                    User     @relation(fields: [userId], references: [id])
  userId                  String
  assignment              Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId            String
  platform                LtiPlatform @relation(fields: [platformId], references: [id])
  platformId              String
  ltiSub                  String
  deploymentId            String?

  lisResultSourcedId      String?
  lisOutcomeServiceUrl    String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([platformId, ltiSub, assignmentId])
  @@index([userId])
  @@index([assignmentId])
}

/// Configuration for translating numeric grades to custom scales or letter grades.
model GradeTranslation {
  id          String       @id @default(cuid())
  name        String       // e.g., "Standard Letter Grades", "Pass/Fail"
  description String?
  
  // The actual mapping logic (e.g., score thresholds or scales)
  maxScore    Float         @default(1.0)
  mapping     Json?

  // Relation back to assignments
  assignments Assignment[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/// A CAS server configuration (e.g., Virginia Tech CAS).
model CasServer {
  id                     String @id @default(cuid())
  name                   String          // Display name (e.g. "Virginia Tech")
  baseUrl                String @unique  // e.g. https://login.vt.edu/profile/cas
  serviceValidateVersion String @default("2.0") // "2.0" or "3.0"

  identities CasIdentity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Linkage between a local User and a CAS identity on a specific server.
model CasIdentity {
  id          String @id @default(cuid())
  userId      String
  casServerId String
  casUsername String // CAS uid

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  casServer CasServer @relation(fields: [casServerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([casServerId, casUsername])
  @@unique([userId, casServerId])
}

/// Rate-limiting and security tracking for login attempts by IP and email.
model LoginAttempt {
  id            String    @id @default(cuid())
  email         String
  ipAddress     String
  attemptCount  Int       @default(1)
  blockedUntil  DateTime?
  lastAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([email, ipAddress])
  @@index([email])
  @@index([ipAddress])
  @@index([lastAttemptAt])
}

/// Ephemeral authentication or verification tokens (e.g., password reset, email verification).
model Token {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([userId, type])
}

/// An LTI course context.
model Course {
  id           String  @id @default(cuid())
  // LTI context claim fields
  ltiContextId String? // context.id from LTI claim
  label        String? // context.label (course code, e.g., "CPS 435")
  title        String? // context.title

  // Canvas-specific custom variables (optional, set via LTI config)
  canvasCourseId String? // $Canvas.course.id
  workflowState  String? // $Canvas.course.workflowState

  // Relationships
  deploymentId     String?
  deployment       LtiDeployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  assignments      Assignment[]
  passTypes        PassType[]
  sections         CourseSection[]
  usersWithCurrent User[]         @relation("UserCurrentCourse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deploymentId, ltiContextId])
  @@index([deploymentId])
}

/// User enrollment in a course with an assigned role.
model Enrollment {
  id              String     @id @default(cuid())
  userId          String
  courseId        String
  role            CourseRole
  courseSectionId String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseSection CourseSection? @relation(fields: [courseSectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([courseSectionId])
}

/// An assignment linked to a course and optional external LTI tool.
model Assignment {
  id             String  @id @default(cuid())
  resourceLinkId String? // resource_link.id from LTI claim
  title          String? // resource_link.title

  // Canvas-specific custom variables
  canvasAssignmentId String? // $Canvas.assignment.id

  //tool information
  toolId        String?
  tool          LtiTool? @relation(fields: [toolId], references: [id], onDelete: SetNull)

  //grade translation option
  gradeTranslationId String?
  gradeTranslation   GradeTranslation? @relation(fields: [gradeTranslationId], references: [id], onDelete: SetNull)

  // Relationships
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Resubmission pass relations
  passEligibilities PassEligibility[]
  passRedemptions   PassRedemption[]
  overrides         AssignmentOverride[]

  ltiResults        LtiResult[] 

  availableFrom DateTime?
  dueDate       DateTime?
  acceptUntil   DateTime?

  eligibleFrom  DateTime?
  eligibleUntil DateTime?

  published     Boolean   @default(true)

  // CBTF Scheduling properties
  isSchedulable       Boolean   @default(false)
  scheduleWindowStart DateTime?
  scheduleWindowEnd   DateTime?
  cbtfReservations    CbtfReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, resourceLinkId])
  @@index([courseId, canvasAssignmentId])
  @@index([toolId])
  @@index([gradeTranslationId])
}

enum PassCoolDownUnit {
  HOUR
  DAY
  WEEK
}

// ─────────────────────────────────────────────────────────
// Resubmission Pass Models
// ─────────────────────────────────────────────────────────

/// Teacher-defined pass template, scoped to a single course.
model PassType {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name        String // e.g. "Quiz Retry Pass", "Late Day"
  description String? // Optional teacher-facing note

  // Policy
  extensionOnly     Boolean @default(false)
  extendsCutoffOnly Boolean @default(false)
  initialBalance    Int     @default(3) // Passes each student starts with
  allowRequests  Boolean @default(false) // Can a student request more?
  hoursPerPass   Float   @default(24) // Hours of extension each pass buys
  titlePattern   String? // Pattern-based matching (regex against Assignment.title)

  /// Max days in the past an assignment's due date can be
  /// for this pass to apply (null = no limit).
  minDaysPastDue Int?
  maxDaysPastDue Int?

  // Cool down period
  coolDownPeriod Int?
  coolDownUnit   PassCoolDownUnit?
  coolDownReset  PassCoolDownUnit?
  coolDownResetOffset Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  eligibilities PassEligibility[]
  prompts       PassPrompt[]
  pools         StudentPassPool[]

  @@index([courseId])
}

/// Defines which assignments a pass type can be used on.
/// NOTE: All eligibility relationships are explicitly stored. Implicit/wildcard eligibility is not supported.
model PassEligibility {
  id          String    @id @default(cuid())
  passTypeId String
  passType   PassType @relation(fields: [passTypeId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  // Track if this was created automatically by a pattern matcher
  isAutomatic Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passTypeId])
}

/// Supplemental choices a student must make when redeeming a pass.
model PassPrompt {
  id          String    @id @default(cuid())
  passTypeId String
  passType   PassType @relation(fields: [passTypeId], references: [id], onDelete: Cascade)

  label       String // Prompt label shown to student
  choicesJson Json // Array of allowed values

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passTypeId])
}

/// Per-student balance for each pass type.
model StudentPassPool {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passTypeId String
  passType   PassType @relation(fields: [passTypeId], references: [id], onDelete: Cascade)

  balance Int // Current remaining passes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  redemptions PassRedemption[]

  @@unique([userId, passTypeId])
}

/// Receipt created each time a student spends a pass.
model PassRedemption {
  id     String           @id @default(cuid())
  poolId String
  pool   StudentPassPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  // What action was taken
  cost Int @default(1) // Number of passes deducted

  // New deadline window
  availableFrom DateTime? // New "available from" time (nullable if unchanged)
  dueDate       DateTime? // New "due at" time
  acceptUntil   DateTime? // New "accept until" cutoff

  /// JSON object mapping PassPrompt.id → chosen value (null if no prompts).
  promptResponsesJson Json?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Canvas override tracking
  canvasOverrideId String? // Canvas assignment override ID if synced to Canvas

  @@index([poolId])
  @@index([assignmentId])
  @@index([canvasOverrideId])
}

// ─────────────────────────────────────────────────────────
// Section & Override Models
// ─────────────────────────────────────────────────────────

/// Represents a section within a course (e.g. synced from Canvas).
model CourseSection {
  id              String   @id @default(cuid())
  courseId        String
  canvasSectionId String?  // Canvas section ID
  name            String   // e.g. "Section 001"
  
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  overrides       AssignmentOverride[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([courseId, canvasSectionId])
  @@index([courseId])
}

/// An override for an assignment's deadline triple, targeting a Course Section or individual students.
model AssignmentOverride {
  id               String    @id @default(cuid())
  assignmentId     String
  canvasOverrideId String?   // Canvas override ID

  title            String?   // e.g. "Section 001", "Individual Accommodation"
  
  // The override deadline triple
  availableFrom    DateTime?
  dueDate          DateTime?
  acceptUntil      DateTime?

  // Target Relations
  assignment       Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  // Section target (optional)
  courseSectionId  String?
  courseSection    CourseSection? @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)

  // Individual student targets (optional)
  studentOverrides AssignmentOverrideStudent[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([assignmentId, canvasOverrideId])
  @@index([assignmentId])
  @@index([courseSectionId])
}

/// Join table for assignment overrides assigned to specific individual students.
model AssignmentOverrideStudent {
  id         String             @id @default(cuid())
  overrideId String
  userId     String

  override   AssignmentOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([overrideId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────
// CBTF (Computer-Based Testing Facility) Models
// ─────────────────────────────────────────────────────────

enum CbtfReservationStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  MISSED
  CANCELLED
}

/// A Computer-Based Testing Facility (room with workstations).
model CbtfFacility {
  id                  String   @id @default(cuid())
  name                String   @default("Main CBTF")
  totalSeats          Int      @default(50)
  /// Definable sequence order for allocating seats across consecutive slots (e.g. [1, 15, 29, 2, ...])
  seatAllocationOrder Json

  /// Maximum minutes before scheduled start time a student is permitted to check in (default: 5)
  checkInLeadMinutes  Int      @default(5)
  /// Maximum minutes after scheduled start time a student is permitted to check in before marked late/missed (default: 15)
  checkInGraceMinutes Int      @default(15)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  operatingHours      CbtfOperatingHours[]
  scheduleExceptions  CbtfScheduleException[]
  proctorShifts       CbtfProctorShift[]
  reservations        CbtfReservation[]
}

/// Weekly recurring operating hours for a facility.
model CbtfOperatingHours {
  id         String       @id @default(cuid())
  facilityId String
  facility   CbtfFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  /// 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  dayOfWeek  Int
  /// Opening time in "HH:mm" 24h format (e.g., "08:00")
  openTime   String
  /// Closing time in "HH:mm" 24h format (e.g., "18:00")
  closeTime  String

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([facilityId, dayOfWeek])
  @@index([facilityId])
}

/// Date-specific exceptions to standard operating hours (holidays, closures, adjusted hours).
model CbtfScheduleException {
  id         String       @id @default(cuid())
  facilityId String
  facility   CbtfFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  /// Target date of the exception (midnight UTC or calendar date)
  date       DateTime
  isClosed   Boolean      @default(false)
  openTime   String?
  closeTime  String?
  reason     String?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([facilityId, date])
}

/// Scheduled work shifts for proctors in the facility.
model CbtfProctorShift {
  id         String       @id @default(cuid())
  facilityId String
  facility   CbtfFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  date       DateTime
  startTime  String
  endTime    String

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([facilityId, date])
  @@index([userId])
}

/// An individual student reservation for an exam in the CBTF.
model CbtfReservation {
  id                 String                @id @default(cuid())
  facilityId         String
  facility           CbtfFacility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  assignmentId       String
  assignment         Assignment            @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  seatNumber         Int
  startTime          DateTime
  endTime            DateTime
  status             CbtfReservationStatus @default(SCHEDULED)

  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  checkedInByUserId  String?
  checkedOutByUserId String?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  notes              CbtfReservationNote[]

  @@index([facilityId, startTime])
  @@index([assignmentId, userId])
  @@index([userId, status])
  @@index([status, startTime])
  @@index([seatNumber, startTime])
}

/// Proctor observation notes and incident logs for a reservation.
model CbtfReservationNote {
  id            String          @id @default(cuid())
  reservationId String
  reservation   CbtfReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  authorId      String
  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content       String          @db.Text
  hasPhotos     Boolean         @default(false)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([reservationId])
  @@index([authorId])
}

