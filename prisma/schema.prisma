// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("NUXT_DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum GlobalRole {
  ADMIN
  INSTRUCTOR
  USER
}

enum CourseRole {
  TEACHER
  STUDENT
  TA
  OBSERVER
  DESIGNER
  ADMIN
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String?
  firstName       String
  lastName        String
  globalRole      GlobalRole @default(USER)
  emailVerified   Boolean    @default(false)
  emailVerifiedAt DateTime?
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  posts         Post[]
  tokens        Token[]
  ltiIdentities LtiIdentity[]
  enrollments   Enrollment[]

  // Essential index only
  @@index([emailVerified])
}

model LtiPlatform {
  id            String   @id @default(uuid())
  issuer        String   @unique // iss claim (e.g., https://canvas.instructure.com)
  clientId      String // aud claim
  authEndpoint  String // OIDC auth initiation endpoint
  tokenEndpoint String // OIDC token endpoint
  jwksEndpoint  String // Platform's public keys
  name          String? // Friendly name
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deployments LtiDeployment[]
  identities  LtiIdentity[]
}

model LtiDeployment {
  id             String  @id @default(uuid())
  platformId     String
  deploymentId   String // LTI deployment_id claim
  deploymentHost String? // Optional guid/host from tool_platform claim

  platform   LtiPlatform   @relation(fields: [platformId], references: [id], onDelete: Cascade)
  identities LtiIdentity[]
  courses    Course[]

  @@unique([platformId, deploymentId])
}

model LtiIdentity {
  id           String @id @default(uuid())
  userId       String
  platformId   String
  ltiSub       String // sub claim (unique user id in the platform)
  platformUserId String? // Optional platform-specific numeric ID (e.g. from Canvas legacy_user_id claim)
  platformApiKey String? // Optional API key for this user on the platform

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     LtiPlatform    @relation(fields: [platformId], references: [id], onDelete: Cascade)
  deployment   LtiDeployment? @relation(fields: [platformId, deploymentId], references: [platformId, deploymentId])
  deploymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platformId, ltiSub])
}

model LoginAttempt {
  id             String    @id @default(uuid())
  email          String
  ipAddress      String
  attemptCount   Int       @default(1)
  blockedUntil   DateTime?
  lastAttemptAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([email, ipAddress])
  @@index([email])
  @@index([ipAddress])
  @@index([lastAttemptAt])
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([userId, type])
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String?
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Essential indexes only
  @@index([createdAt])
  @@index([authorId])
}

model Course {
  id             String   @id @default(uuid())
  // LTI context claim fields
  ltiContextId   String   // context.id from LTI claim
  label          String?  // context.label (course code, e.g., "CPS 435")
  title          String?  // context.title

  // Canvas-specific custom variables (optional, set via LTI config)
  canvasCourseId String?  // $Canvas.course.id
  workflowState  String?  // $Canvas.course.workflowState

  // Relationships
  deploymentId   String
  deployment     LtiDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  assignments    Assignment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([deploymentId, ltiContextId])
}

model Enrollment {
  id        String     @id @default(uuid())
  userId    String
  courseId  String
  role      CourseRole

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, courseId])
}

model Assignment {
  id             String   @id @default(uuid())
  resourceLinkId String   // resource_link.id from LTI claim
  title          String?  // resource_link.title
  
  // Canvas-specific custom variables
  canvasAssignmentId String? // $Canvas.assignment.id
  
  // Relationships
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([courseId, resourceLinkId])
}
